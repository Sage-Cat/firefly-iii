[Unit]
Description=Maintain dated NBU rates for UAH and EUR reporting
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/firefly-iii/contrib/ukrainian-banks/.state/api-token

[Service]
Type=oneshot
WorkingDirectory=%h/firefly-iii/contrib/ukrainian-banks
ExecStart=/usr/bin/python3 %h/firefly-iii/contrib/ukrainian-banks/nbu_rates.py
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=10min
