[Unit]
Description=Assign expense budgets and restore missing period limits
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/firefly-iii/contrib/ukrainian-banks/.state/budgets/config.json
ConditionPathExists=%h/firefly-iii/contrib/ukrainian-banks/.state/api-token

[Service]
Type=oneshot
WorkingDirectory=%h/firefly-iii/contrib/ukrainian-banks
ExecStart=/usr/bin/python3 %h/firefly-iii/contrib/ukrainian-banks/budget_sync.py
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=10min
